#include <Arduino.h>

const unsigned char UBX_HEADER[] = { 0xB5, 0x62 }; // UBX header bytes

// UBX NAV-POSLLH message structure
struct NAV_POSLLH {
  unsigned char cls;
  unsigned char id;
  unsigned short len;
  unsigned long iTOW; //timestamof waking
  long lon; // longitude in 1e-7 degrees
  long lat; // latitude in 1e-7 degrees
  long height; // height above ellipsoid in mm
  long hMSL; // height above mean sea level in mm
  unsigned long hAcc; // horizontal accuracy estimate in mm
  unsigned long vAcc; // vertical accuracy estimate in mm
};

NAV_POSLLH posllh;

void calcChecksum(unsigned char* CK) {
  memset(CK, 0, 2);
  for (int i = 0; i < (int)sizeof(NAV_POSLLH); i++) {
    CK[0] += ((unsigned char*)(&posllh))[i];
    CK[1] += CK[0];
  }
}

bool processGPS() { //does the actual reading of the GPS data and returns true if a valid message was received
  static int fpos = 0;
  static unsigned char checksum[2];
  const int payloadSize = sizeof(NAV_POSLLH);

  while ( Serial.available() ) {
    byte c = Serial.read();
    if ( fpos < 2 ) {
      if ( c == UBX_HEADER[fpos] ) //tries to find UBX header
        fpos++;
      else
        fpos = 0;
    }
    else {
      if ( (fpos-2) < payloadSize )
        ((unsigned char*)(&posllh))[fpos-2] = c;

      fpos++;

      if ( fpos == (payloadSize+2) ) {
        calcChecksum(checksum);
      }
      else if ( fpos == (payloadSize+3) ) {
        if ( c != checksum[0] )
          fpos = 0;
      }
      else if ( fpos == (payloadSize+4) ) {
        fpos = 0;
        if ( c == checksum[1] ) {
          return true;
        }
      }
      else if ( fpos > (payloadSize+4) ) {
        fpos = 0;
      }
    }
  }
  return false;
}

void setup() 
{
  Serial.begin(9600);
}

void loop() {
  if ( processGPS() ) {
    // do something with GPS data
  }
}

